# Python cache
__pycache__/
*.py[cod]

# Embedded git repos. Use /* not / so a negation below can re-include a
# subdirectory: git never descends into an excluded directory.
.claude/skills/*
# ...except skills authored for this project
!.claude/skills/gkg-signinghub-reference/

# Temporary Office files
~$*.docx

# Raw inputs sourced verbatim from the PRIVATE backend repo. This project's repo
# is public: never publish the backend openapi.yaml or doc-meta.yaml here.
formatted/**/openapi.yaml
formatted/**/doc-meta.yaml

# Regeneration/fixer backups (byte-duplicates of their originals).
*.docx.orig

# Renderer snapshot is just this repo at a pinned commit; not evidence worth duplicating.
formatted/**/engine/
formatted/**/engine.zip
